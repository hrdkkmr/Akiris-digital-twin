# --- TwinLine configuration (copy to .env; all optional, sane defaults) ---

# database: sqlite zero-config locally; postgres in docker
TWIN_DATABASE_URL=sqlite:///data/generated/twinline.db
# TWIN_DATABASE_URL=postgresql://twin:twin@localhost:5432/twinline

# generator
TWIN_DEFAULT_SEED=42
TWIN_SEED_VEHICLES=1500
TWIN_SCENARIO=mixed

# ingest tuning
TWIN_BULK_CHUNK=5000
TWIN_RAW_SENSOR_STREAM=false

# business assumptions (labeled, configurable — never hard-coded claims)
TWIN_COST_PER_SCRAPPED_VEHICLE=1500
TWIN_COST_DOWNTIME_PER_HOUR=1300
TWIN_PLANNED_ANNUAL_VEHICLES=250000
TWIN_ASSUMED_DEFECT_REDUCTION_PCT=0.15
TWIN_ASSUMED_DOWNTIME_REDUCTION_PCT=0.05

# frontend
VITE_API_URL=/api
API_UPSTREAM=http://localhost:8000

# api hardening (production posture)
TWIN_API_KEY=
TWIN_CORS_ORIGINS=*
TWIN_LOG_LEVEL=INFO

# production hardening (rate limiting & observability)
TWIN_RATE_LIMIT_PER_MIN=120

# --- Observability Advisor (Innovation 1) ---
TWIN_OBS_HIGH_CONFIDENCE=0.75
TWIN_OBS_MEDIUM_CONFIDENCE=0.55
TWIN_OBS_CRITICAL_CONFIDENCE=0.35
TWIN_OBS_LOW_COVERAGE=0.5
TWIN_OBS_CRITICAL_COVERAGE=0.3
TWIN_OBS_COMPLETENESS_MIN=0.75
TWIN_OBS_STALE_S=600

# --- Safe change validation / shadow simulation (Innovation 3) ---
TWIN_MAINT_WINDOW_START_H=6.0        # next maintenance window begins at 06:00 sim clock
TWIN_MAINT_WINDOW_DURATION_H=2.0     # window length in hours
TWIN_MAINT_WINDOW_INTERVAL_H=24.0    # windows repeat daily
TWIN_MAINT_MAX_QUEUE_ITEMS=8         # queue capacity per window
